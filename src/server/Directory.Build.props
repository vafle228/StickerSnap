<Project>

  <!-- Shared by every project of the server solution (StickerSnap.slnx). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The app's version, as in src/desktop/package.json; GET /api/v1/app reports it. -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A newly published advisory warns, but does not break a build that passed yesterday. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
