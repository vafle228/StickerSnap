{
  "name": "stickersnap",
  "private": true,
  "workspaces": [
    "src/ds",
    "src/web",
    "src/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w src/web",
    "build": "npm run build -w src/web",
    "build:dev": "npm run build:dev -w src/web",
    "check:prod-build": "node tools/check-prod-build.mjs",
    "fetch:ffmpeg": "node tools/fetch-ffmpeg.mjs",
    "lint": "npm run lint -w src/ds -w src/web",
    "typecheck": "npm run typecheck -w src/ds -w src/web",
    "test": "npm run test -w src/ds -w src/web",
    "e2e": "npm run e2e -w src/web",
    "e2e:server": "npm run e2e:server -w src/web",
    "format": "prettier --write src/ds src/web src/desktop tools",
    "format:check": "prettier --check src/ds src/web src/desktop tools",
    "gen:tokens": "node tools/build-tokens.mjs",
    "check:tokens": "node tools/build-tokens.mjs --check",
    "gen:api": "openapi-typescript src/contract/openapi.yaml -o src/web/src/shared/api/schema.d.ts && node tools/build-events.mjs",
    "check:api": "openapi-typescript src/contract/openapi.yaml -o src/web/src/shared/api/schema.d.ts --check && node tools/build-events.mjs --check",
    "typecheck:api": "tsc --strict --noEmit src/web/src/shared/api/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "js-yaml": "^4.1.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
