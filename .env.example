# Bot service (src/bot). Copy to .env beside this file and fill in; .env is in .gitignore.
# Development reads it with `uv run --env-file ../../.env` from src/bot,
# docker compose (docker/bot/compose.yaml) passes it to the container with env_file.

# Token from @BotFather: the dev bot here, the production bot only on the VPS
BOT_TOKEN=
# polling (development) or webhook (production)
BOT_MODE=polling
# Webhook mode only: public HTTPS address of the service and a random secret
# (python -c "import secrets; print(secrets.token_urlsafe(32))")
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
# Another Bot API server, e.g. a fake one; empty means the real Telegram
TELEGRAM_API_URL=
