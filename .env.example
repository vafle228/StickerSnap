# Bot service (src/telegram/bot). Copy to .env beside this file and fill in; .env is in .gitignore.
# Development reads it with `uv run --env-file ../../../.env` from src/telegram/bot,
# docker compose (docker/telegram/compose.yaml) passes it to the container with env_file.
# On the VPS it lies in ~/stickersnap/.env beside compose.yaml (docker/telegram/compose.prod.yaml),
# which sets BOT_MODE, WEBHOOK_BASE_URL and MINIAPP_URL itself from DOMAIN.

# VPS only: the service's domain, its DNS A record pointing at the VPS; Caddy gets its certificate
# DOMAIN=bot.example.com

# Token from @BotFather: the dev bot here, the production bot only on the VPS
BOT_TOKEN=
# polling (development) or webhook (production)
BOT_MODE=polling
# Webhook mode only: public HTTPS address of the service and a random secret
# (python -c "import secrets; print(secrets.token_urlsafe(32))")
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
# The Mini App's HTTPS address, opened by the bot's menu button; empty keeps the commands menu
# (the dev bot, whose Mini App runs on localhost)
MINIAPP_URL=
# Another Bot API server, e.g. a fake one; empty means the real Telegram
TELEGRAM_API_URL=
# «Скачать для Windows и Linux» in the bot's messages, the GitHub releases page when not set
# DOWNLOAD_URL=https://github.com/vafle228/StickerSnap/releases/latest
# Where feedback goes: your chat id with the bot (from /start's update) or a group's (-100...);
# empty keeps feedback only in the database
FEEDBACK_CHAT_ID=
