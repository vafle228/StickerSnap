[Rr]elease/
[Ll]og/
[Ll]ogs/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.rsuser
project.lock.json
artifacts/
publish/
# The publish feature's own folders, which a case-blind file system takes for publish/ above
!src/server/**/Publish/
PublishProfiles/
*.nupkg
*.snupkg
TestResults/
*.trx
*.coverage
*.coveragexml

# ---- Secrets (bot token lives in app secrets, never in git) ----
.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json
*.pfx
*.p12

# ---- FFmpeg binaries and render output ----
ffmpeg/
# the server's Ffmpeg folders are code (git ignores case on Windows)
!src/server/**/Ffmpeg/
ffmpeg.exe
ffprobe.exe
ffmpeg-*/
*.webm
!.github/**/*.webm
# small samples the server tests read as resources
!src/server/StickerSnap.Tests/TestData/**/*.webm
renders/
tmp/
temp/

# ---- Electron packaging ----
# the server published for the shell (npm run server -w src/desktop)
server-dist/
*.AppImage
*.deb
*.rpm
*.snap
*.exe
*.msi
*.blockmap
latest*.yml

