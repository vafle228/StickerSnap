{
  // The desktop app from VS Code: Terminal → Run Task (or Ctrl+Shift+B for the production one).
  // Production has no demo data or dev bar; dev is «StickerSnap Dev» with the demo scenarios.
  // Output: src/desktop/release (production) and src/desktop/release/dev.
  // The server: run it, its tests (Ctrl+Shift+P → Run Test Task) and the pinned FFmpeg.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Приложение: прод",
      "detail": "Распакованное приложение без демо-данных: release/win-unpacked или linux-unpacked",
      "type": "shell",
      "command": "npm run package -w src/desktop",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Приложение: dev",
      "detail": "StickerSnap Dev с dev-полосой и демо-сценариями: release/dev",
      "type": "shell",
      "command": "npm run package -w src/desktop -- --dev",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Установщик: прод",
      "detail": "NSIS на Windows, AppImage и deb на Linux",
      "type": "shell",
      "command": "npm run package -w src/desktop -- --installer",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Установщик: dev",
      "detail": "Установщик StickerSnap Dev",
      "type": "shell",
      "command": "npm run package -w src/desktop -- --dev --installer",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Сервер: запустить",
      "detail": "ASP.NET на http://127.0.0.1:5180, SPA из npm run build или Vite с прокси",
      "type": "shell",
      "command": "dotnet run --project src/server/StickerSnap.Api",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Сервер: тесты",
      "detail": "Быстрые тесты сервера, как в CI (без Category=Slow)",
      "type": "shell",
      "command": "dotnet test --solution StickerSnap.slnx --filter-not-trait Category=Slow",
      "options": { "cwd": "${workspaceFolder}/src/server" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "FFmpeg: скачать",
      "detail": "Закреплённая LGPL-сборка FFmpeg 9.0 в tools/ffmpeg/<rid>",
      "type": "shell",
      "command": "npm run fetch:ffmpeg",
      "problemMatcher": []
    }
  ]
}
